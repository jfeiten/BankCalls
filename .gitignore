# =========================================================================
# || GENERAL                                                             ||
# =========================================================================

# Dependencies & Build Artifacts
# These directories are generated by your package manager (npm, yarn, pnpm)
# and the build process. They should never be committed.
node_modules/
dist/

# Logs
# Log files can be verbose and are specific to a user's machine.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================================================================
# || ENVIRONMENT & SENSITIVE FILES                                       ||
# =========================================================================

# Environment variables
# These files contain environment-specific configurations and often sensitive
# data like API keys. The .env.local file is for local-only secrets.
# Only commit template files (e.g., .env.example).
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =========================================================================
# || DEVELOPMENT & IDE                                                   ||
# =========================================================================

# IDE-specific configuration files
# These are personal settings for your code editor and don't belong in a
# shared repository.
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
# Test reports and coverage analysis results are generated on each run.
coverage/
.nycrc
.nyc_output/

# Caching
# Caches from various tools to speed up local development.
.vite/
.eslintcache

# =========================================================================
# || OPERATING SYSTEM & MISCELLANEOUS                                    ||
# =========================================================================

# OS-specific files
# These are metadata files created by macOS, Windows, and Linux systems.
.DS_Store
Thumbs.db
desktop.ini

# Miscellaneous temporary files
# Files that may be generated by other tools or processes.
*.lock
*.log
node_modules/
